# Admin panel authentication (set these in .env.local and Vercel Project Environment Variables)
ADMIN_PASSWORD=change-me-to-a-strong-passphrase
# Optional dedicated HMAC signing secret (>= 32 chars recommended; falls back to derived key from ADMIN_PASSWORD)
SESSION_SECRET=replace-with-random-32-char-secret

# Name.com Core API (for harrylee.dev direct create/list/delete)
NAMECOM_USERNAME=your-namecom-username
NAMECOM_TOKEN=your-namecom-api-token
# Optional override for Name.com sandbox testing: https://api.dev.name.com
# NAMECOM_API_BASE=https://api.name.com

# Cloudflare API (for domains moved to Cloudflare NS, dnsProvider: cloudflare-api)
# Needs Zone:Read + Zone:DNS:Edit permissions
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# Optional per-domain Zone ID override (e.g. CLOUDFLARE_ZONE_ID_VINAMUSE_STORE=...)
# CLOUDFLARE_ZONE_ID=your-default-zone-id
